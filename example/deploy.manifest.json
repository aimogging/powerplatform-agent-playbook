{
  "_comment": "DEV-TENANT deployment of the example with tools/deploy.py. Build first (python example/build.py --base <download>) so example/dist/src holds the flows with YOUR site URL substituted. After the first successful deploy set mustExist:true on ContosoHelpDeskNotifyNewTicket: it is list-triggered, and a name miss must never create a second, double-firing copy.",
  "provision": [
    { "id": "P1", "schema": "example/sharepoint/helpdesk.schema.json" }
  ],
  "flows": [
    { "displayName": "ContosoHelpDeskSubmitTicket", "source": "example/dist/src/ContosoHelpDeskSubmitTicket", "start": true },
    { "displayName": "ContosoHelpDeskNotifyNewTicket", "source": "example/dist/src/ContosoHelpDeskNotifyNewTicket", "start": true, "mustExist": false }
  ],
  "apps": [
    {
      "displayName": "Contoso Help Desk",
      "msapp": "example/dist/Contoso Help Desk.msapp",
      "src": "example/canvas/Src",
      "allowCreate": true,
      "requiredFlows": ["ContosoHelpDeskSubmitTicket"],
      "refreshTableSchemas": true,
      "refreshFlowSignatures": true
    }
  ],
  "stages": [
    { "id": "S1", "flows": ["ContosoHelpDeskSubmitTicket", "ContosoHelpDeskNotifyNewTicket"], "apps": ["Contoso Help Desk"] }
  ],
  "gates": { "runtimeRules": true }
}
